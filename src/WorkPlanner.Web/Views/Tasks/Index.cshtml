<div class="row">

    @foreach (var item in Model)
    {
        <div class="col-md-4 mb-4">

            <div class="card h-100 shadow-sm">

                <div class="card-body">

                    <h5 class="card-title">
                        @item.Title
                    </h5>

                    <p class="card-text">
                        @item.Description
                    </p>

                    <p>
                        <strong>Status:</strong>
                        <span class="badge
                        @(item.Status switch
                        {
                            WorkPlanner.Web.Enums.TaskStatus.New => "bg-secondary",
                             WorkPlanner.Web.Enums.TaskStatus.InProgress => "bg-primary",
                             WorkPlanner.Web.Enums.TaskStatus.Blocked => "bg-danger",
                             WorkPlanner.Web.Enums.TaskStatus.Completed => "bg-success",
                            _ => "bg-dark"
                        })">
                            @item.Status
                        </span>
                    </p>

                    <p>
                        <strong>Priority:</strong>
                        <span class="badge
                            @(item.Priority switch
                            {
                                TaskPriority.Low => "bg-success",
                                TaskPriority.Medium => "bg-info",
                                TaskPriority.High => "bg-warning",
                                TaskPriority.Critical => "bg-danger",
                                _ => "bg-secondary"
                            })">
                            @item.Priority
                        </span>
                    </p>

                    <p>
                        <strong>Due:</strong>
                        @(item.DueDate?.ToString("dd MMM yyyy"))
                    </p>

                </div>

                <div class="card-footer">

                    <a asp-action="Edit"
                       asp-route-id="@item.TaskItemId"
                       class="btn btn-sm btn-warning">
                        Edit
                    </a>

                    <a asp-action="Details"
                       asp-route-id="@item.TaskItemId"
                       class="btn btn-sm btn-info">
                        Details
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@item.TaskItemId"
                       class="btn btn-sm btn-danger">
                        Delete
                    </a>

                </div>

            </div>

        </div>
    }
</div>
