@model IEnumerable<WorkPlanner.Web.Models.TaskItem>

@{
    ViewData["Title"] = "Index";
}

<h1>Task Manager</h1>

<p>
    Manage and track your work items.
</p>
<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Status)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Priority)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DueDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CreatedDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ModifiedDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CompletedDate)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(model => item.Title)
                </td>
                <td>
                    @Html.DisplayFor(model => item.Description)
                </td>
                <td>
                    @Html.DisplayFor(model => item.Status)
                </td>
                <td>
                    @Html.DisplayFor(model => item.Priority)
                </td>
                <td>
                    @Html.DisplayFor(model => item.DueDate)
                </td>
                <td>
                    @Html.DisplayFor(model => item.CreatedDate)
                </td>
                <td>
                    @Html.DisplayFor(model => item.ModifiedDate)
                </td>
                <td>
                    @Html.DisplayFor(model => item.CompletedDate)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.TaskItemId">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.TaskItemId">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.TaskItemId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
